<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.jacobdecker.CheckChinese</string>
	<key>CFBundleName</key>
	<string>Accuracy Checker</string>
	<key>CFBundleDisplayName</key>
	<string>Accuracy Checker</string>
	<key>CFBundleExecutable</key>
	<string>CheckChinese</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Background app: no Dock icon, no menu bar -->
	<key>LSUIElement</key>
	<true/>
	<!-- Adds "Accuracy Checker" to the right-click › Services menu for selected text -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Accuracy Checker</string>
			</dict>
			<key>NSMessage</key>
			<string>checkChinese</string>
			<key>NSPortName</key>
			<string>Accuracy Checker</string>
			<!-- Without this, macOS adds the service switched OFF by default -->
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>NSStringPboardType</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
